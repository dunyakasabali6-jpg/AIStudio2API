# Northflank Free starting profile. Configure these in the platform environment,
# not by committing secrets to this file.
LISTEN_ADDR=0.0.0.0:2048
# Optional single account: set both values. Never commit real credentials.
# BOOTSTRAP_EMAIL=you@gmail.com
# BOOTSTRAP_COOKIE=__Secure-1PSID=...; __Secure-1PSIDTS=...; ...
# Or use BOOTSTRAP_COOKIES_JSON='[{"email":"you@gmail.com","cookie":"Cookie: ..."}]'
WAA_BACKEND=spidermonkey
AUTO_START=true
WARM_WORKER_LIMIT=1
MAX_ACTIVE_WORKERS=2
WARM_STARTUP_CONCURRENCY=1
PER_ACCOUNT_CONCURRENCY=1
LOG_FILE=false
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
PROXY_API_KEY=CHANGE_ME
